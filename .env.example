# Copy to .env.local and set your own TypeSafe API key.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional text drafting and recovery helper. Jev still chooses computer actions.
# Cerebras takes precedence when both providers are configured.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
